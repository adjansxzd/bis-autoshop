# Copy to .env (or set as environment variables) for production. Never commit the real .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Optional: "Sign in with Google" (docs/GOOGLE_SIGN_IN.md). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
# 1 = the site runs behind HTTPS (secure cookies, HSTS, redirect to https)
HTTPS=0
# sign-in / registration attempts per minute from one IP
AUTH_RATE=10/min
